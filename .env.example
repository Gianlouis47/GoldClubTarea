# =========================================
# Gold Club - variables de entorno
# =========================================
# 1. Copia este archivo y llamalo  .env   (sin el .example)
# 2. Rellena los dos valores desde tu proyecto de Supabase:
#      Supabase Dashboard -> Project Settings -> API
# 3. Reinicia el servidor:  npm run dev
#
# El archivo .env esta en .gitignore: NO se sube al repositorio.
# =========================================

# URL del proyecto. Ejemplo: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Clave publica "anon" / "publishable". Es la unica que puede ir en el
# navegador. NUNCA pongas aqui la service_role key.
VITE_SUPABASE_ANON_KEY=
